+def _runner_code_sha256() -> str:
+    """Hash the exact runner and frozen config bytes that produced a cell."""
+    digest = hashlib.sha256()
+    for path in (__file__, os.path.join(os.path.dirname(os.path.abspath(__file__)), "config.py")):
+        with open(path, "rb") as handle:
+            digest.update(handle.read())
+    return digest.hexdigest()
+
+
+def _nvidia_smi_sample() -> Dict:
+    """Capture one best-effort GPU utilization/memory sample after a cell completes."""
+    command = [
+        "nvidia-smi",
+        "--query-gpu=utilization.gpu,memory.used",
+        "--format=csv,noheader,nounits",
+    ]
+    try:
+        result = subprocess.run(command, check=True, capture_output=True, text=True, timeout=10)
+        line = next((item.strip() for item in result.stdout.splitlines() if item.strip()), "")
+        util, memory = [part.strip() for part in line.split(",", 1)]
+        return {"util_pct": int(util), "mem_mib": int(memory)}
+    except (OSError, subprocess.SubprocessError, StopIteration, ValueError) as error:
+        return {"util_pct": None, "mem_mib": None, "error": str(error)}
+
+
+def _utc_iso() -> str:
+    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
+
+
+def _runner_stamp(wall_start: str, monotonic_start: float, gpu_sample: Dict) -> Dict:
+    return {
+        "code_sha256": _runner_code_sha256(),
+        "pid": os.getpid(),
+        "hostname": socket.gethostname(),
+        "wall_start": wall_start,
+        "wall_end": _utc_iso(),
+        "elapsed_s": time.monotonic() - monotonic_start,
+        "nvidia_smi_sample": gpu_sample,
+        "stamp_version": 1,
+    }
+
+
+def _atomic_json_dump(payload: Dict, path: str) -> None:
+    """Publish a complete cell and runner stamp in one atomic rename."""
+    directory = os.path.dirname(os.path.abspath(path))
+    os.makedirs(directory, exist_ok=True)
+    fd, temporary = tempfile.mkstemp(prefix=f".{os.path.basename(path)}.", suffix=".tmp",
+                                     dir=directory)
+    try:
+        with os.fdopen(fd, "w") as handle:
+            json.dump(payload, handle)
+            handle.flush()
+            os.fsync(handle.fileno())
+        os.replace(temporary, path)
+    except BaseException:
+        try:
+            os.unlink(temporary)
+        except FileNotFoundError:
+            pass
+        raise
 
 
